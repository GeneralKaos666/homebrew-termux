diff --git a/Library/Homebrew/bottle_specification.rb b/Library/Homebrew/bottle_specification.rb
index d95fa18..225c0a2 100644
--- a/Library/Homebrew/bottle_specification.rb
+++ b/Library/Homebrew/bottle_specification.rb
@@ -100,7 +100,12 @@ class BottleSpecification
     prefix = Pathname(cellar.to_s).parent.to_s
 
     # Raw prefix strings are patched in place, so the byte length decides.
-    relocatable = !Homebrew::EnvConfig.no_relocate_build_prefix?
+    # homebrew-termux: Termux's prefix is always longer than the 26-byte
+    # /home/linuxbrew/.linuxbrew that Linux bottles are built at. Placeholdered
+    # text and RPATH/interpreter relocation is length independent, and the
+    # build-prefix C-string relocation skipped on Termux would fail at a longer
+    # prefix anyway, so accept the bottle instead of forcing a source build.
+    relocatable = Homebrew.termux? || !Homebrew::EnvConfig.no_relocate_build_prefix?
     cellar_relocatable = relocatable && cellar.to_s.bytesize >= HOMEBREW_CELLAR.to_s.bytesize
     prefix_relocatable = relocatable && prefix.bytesize >= HOMEBREW_PREFIX.to_s.bytesize
 
diff --git a/Library/Homebrew/cmd/update-reset.sh b/Library/Homebrew/cmd/update-reset.sh
index e6f265f..cad18e5 100644
--- a/Library/Homebrew/cmd/update-reset.sh
+++ b/Library/Homebrew/cmd/update-reset.sh
@@ -95,6 +95,24 @@ homebrew-update-reset() {
       git -C "${DIR}" checkout --force -B "${head}" origin/HEAD
     fi
     rm -rf "${DIR}/.git/describe-cache"
+    # homebrew-termux: this command force-checks-out upstream over the Termux
+    # compat patches, and its git wrapper disables hooks, so nothing re-applies
+    # them on the way out. Without this the repository is left unpatched and
+    # bin/brew's patched shebang is gone. The tooling path is recorded in the
+    # checkout's local git config (see apply-patches.sh) and lives outside the
+    # tree, so it survives the reset.
+    if [[ "${DIR}" == "${HOMEBREW_REPOSITORY}" && -d "/data/data/com.termux/files/usr/glibc" ]]
+    then
+      local termux_apply_patches
+      termux_apply_patches="$(git -C "${DIR}" config --local --get homebrew-termux.applypatches 2>/dev/null)"
+      [[ -n "${termux_apply_patches}" ]] ||
+        termux_apply_patches="${HOME}/.homebrew/homebrew-termux/apply-patches.sh"
+      if [[ -x "${termux_apply_patches}" ]]
+      then
+        bash "${termux_apply_patches}" "${DIR}" --commit ||
+          opoo "Could not re-apply the Termux compat patches; re-run install.sh."
+      fi
+    fi
     echo
   done
 }
